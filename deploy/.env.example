# Copy to .env and fill in what you use. Never commit the real file.

# LLM provider key — the one your workforce.toml [llm] provider needs.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Gateway auth. Unset, the hub generates a token and prints it at start-up.
WORKFORCE_GATEWAY_TOKEN=
# Signs admin JWTs. Use an independent random value of 32+ bytes.
WORKFORCE_JWT_SECRET=

# Passphrase for the secrets vault.
WORKFORCE_VAULT_KEY=

# Slack (Socket Mode), if you connect Slack.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
